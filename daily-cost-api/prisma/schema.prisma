// Daily Cost - V1 (online-only, multi-device families)
// NestJS + PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  REMOVED
}

enum CalendarType {
  JALALI
  GREGORIAN
}

enum WalletType {
  CASH
  BANK
  MOBILE_MONEY
  SAVINGS
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

// ---------- Identity ----------

model User {
  id           String       @id @default(uuid()) @db.Uuid
  fullName     String       @map("full_name")
  phone        String?      @unique
  email        String?      @unique
  passwordHash String       @map("password_hash")
  language     String       @default("fa") // fa (Dari) | ps (Pashto) | en
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  ownedFamilies Family[]       @relation("FamilyOwner")
  memberships   Member[]
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  transactions  Transaction[]  @relation("TxCreatedBy")
  wallets       Wallet[]       @relation("WalletCreatedBy")
  invitations   Invitation[]   @relation("InvitationCreatedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// FCM tokens for push notifications ("Ahmad added an expense")
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ---------- Family ----------

model Family {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String       @map("owner_id") @db.Uuid
  currency  String       @default("AFN") // ISO 4217
  calendar  CalendarType @default(JALALI)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  owner        User         @relation("FamilyOwner", fields: [ownerId], references: [id])
  members      Member[]
  invitations  Invitation[]
  wallets      Wallet[]
  categories   Category[]
  transactions Transaction[]

  @@map("families")
}

// Role lives on the membership, not on the user:
// the same person can be OWNER in one family and MEMBER in another.
model Member {
  id       String       @id @default(uuid()) @db.Uuid
  familyId String       @map("family_id") @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  role     FamilyRole   @default(MEMBER)
  status   MemberStatus @default(ACTIVE)
  joinedAt DateTime     @default(now()) @map("joined_at")

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id        String     @id @default(uuid()) @db.Uuid
  familyId  String     @map("family_id") @db.Uuid
  code      String     @unique // short, human-friendly (e.g. 8 chars)
  role      FamilyRole @default(MEMBER)
  createdBy String     @map("created_by") @db.Uuid
  expiresAt DateTime   @map("expires_at")
  usedBy    String?    @map("used_by") @db.Uuid
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator User   @relation("InvitationCreatedBy", fields: [createdBy], references: [id])

  @@index([familyId])
  @@map("invitations")
}

// ---------- Money ----------

model Wallet {
  id                  String       @id @default(uuid()) @db.Uuid
  familyId            String       @map("family_id") @db.Uuid
  name                String
  type                WalletType   @default(CASH)
  openingBalanceMinor Int          @default(0) @map("opening_balance_minor")
  status              RecordStatus @default(ACTIVE)
  createdBy           String       @map("created_by") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  deletedAt           DateTime?    @map("deleted_at")

  family  Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creator User   @relation("WalletCreatedBy", fields: [createdBy], references: [id])

  outgoing Transaction[] @relation("TxWallet")
  incoming Transaction[] @relation("TxToWallet")

  @@index([familyId])
  @@map("wallets")
}

// Default categories (Food, Health, Education, ...) are copied into each family
// when it is created. Defaults carry a nameKey (translated in the app);
// custom categories use `name`.
model Category {
  id        String       @id @default(uuid()) @db.Uuid
  familyId  String       @map("family_id") @db.Uuid
  type      CategoryType
  name      String? // custom categories
  nameKey   String?      @map("name_key") // e.g. "category.food" for defaults
  icon      String?
  sortOrder Int          @default(0) @map("sort_order")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([familyId, type])
  @@map("categories")
}

// The single source of truth for money movement.
// Wallet balance = openingBalance + income - expense + transfers in - transfers out.
// Amounts are integers in minor units, never floats.
model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  familyId    String          @map("family_id") @db.Uuid
  type        TransactionType
  walletId    String          @map("wallet_id") @db.Uuid
  toWalletId  String?         @map("to_wallet_id") @db.Uuid // TRANSFER only
  categoryId  String?         @map("category_id") @db.Uuid // INCOME / EXPENSE only
  amountMinor Int             @map("amount_minor") // always > 0
  note        String?
  occurredAt  DateTime        @map("occurred_at") // when it happened
  createdBy   String          @map("created_by") @db.Uuid
  updatedBy   String?         @map("updated_by") @db.Uuid
  version     Int             @default(1) // optimistic locking
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  wallet   Wallet    @relation("TxWallet", fields: [walletId], references: [id])
  toWallet Wallet?   @relation("TxToWallet", fields: [toWalletId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  creator  User      @relation("TxCreatedBy", fields: [createdBy], references: [id])

  @@index([familyId, occurredAt])
  @@index([familyId, categoryId, occurredAt])
  @@index([walletId])
  @@map("transactions")
}
