# Copy to .env and fill in. Never commit .env.
# The API validates these at startup (src/config/env.validation.ts) and refuses
# to start, naming the variable, when one is missing or invalid.

# --- Docker Compose (PostgreSQL container) ---
DB_USER=dailycost
DB_PASSWORD=change-me
DB_NAME=dailycost
DB_PORT=5433

# --- API ---
# development | production | test (default: development)
NODE_ENV=development
# 1-65535 (default: 3000)
PORT=3000
# REQUIRED. Must match the DB_* values above. URL-encode special characters in the password.
DATABASE_URL="postgresql://dailycost:change-me@localhost:5433/dailycost?schema=public"
# REQUIRED, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# 60-86400 seconds (default: 900)
ACCESS_TOKEN_TTL_SECONDS=900
# 1-365 days (default: 30)
REFRESH_TOKEN_TTL_DAYS=30
