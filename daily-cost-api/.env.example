# Copy to .env and fill in. Never commit .env.
# The API validates these at startup (src/config/env.validation.ts) and refuses
# to start, naming the variable, when one is missing or invalid.

# --- Docker Compose (PostgreSQL container) ---
DB_USER=dailycost
DB_PASSWORD=change-me
DB_NAME=dailycost
DB_PORT=5433

# --- API ---
# development | production | test (default: development)
NODE_ENV=development
# 1-65535 (default: 3000)
PORT=3000
# REQUIRED. Must match the DB_* values above. URL-encode special characters in the password.
DATABASE_URL="postgresql://dailycost:change-me@localhost:5433/dailycost?schema=public"
# REQUIRED, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# 60-86400 seconds (default: 900)
ACCESS_TOKEN_TTL_SECONDS=900
# 1-365 days (default: 30)
REFRESH_TOKEN_TTL_DAYS=30

# --- Email (verification codes) ---
# Local development uses Mailpit (docker compose): SMTP on localhost:1025,
# inbox at http://localhost:8025. Nothing is really sent.
# Required in production; blank or absent in development means localhost.
MAIL_HOST=localhost
# 1-65535 (default: 1025)
MAIL_PORT=1025
# "address" or "Name <address>"
MAIL_FROM="Daily Cost <no-reply@dailycost.local>"
# true only for implicit TLS (port 465); port 587 uses STARTTLS with false (default: false)
MAIL_SECURE=false
# Leave blank when the server needs no login (Mailpit)
MAIL_USER=
MAIL_PASSWORD=
# 1-60 minutes (default: 15)
EMAIL_CODE_TTL_MINUTES=15
# Optional: change the host ports if another project already uses 1025 / 8025
# MAILPIT_SMTP_PORT=1025
# MAILPIT_WEB_PORT=8025

# Authentication rate limiting
# Maximum requests per endpoint, per client IP, per window.
AUTH_RATE_LIMIT=10

# Time window in seconds (1-3600).
AUTH_RATE_WINDOW_SECONDS=60