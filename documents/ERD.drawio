olor=#23445d;labelBackgroundColor=default;" edge="1" parent="1" source="t_families" target="t_categories"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;rounded=0;strokeColor=#23445d;labelBackgroundColor=default;" edge="1" parent="1" source="t_families" target="t_transactions"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="wallet / to_wallet" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;rounded=0;strokeColor=#23445d;labelBackgroundColor=default;" edge="1" parent="1" source="t_wallets" target="t_transactions"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;rounded=0;strokeColor=#23445d;labelBackgroundColor=default;" edge="1" parent="1" source="t_categories" target="t_transactions"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="created_by" style="edgeStyle=entityRelationEdgeStyle;fontSize=11;html=1;startArrow=ERmandOne;endArrow=ERoneToMany;startFill=0;endFill=0;rounded=0;strokeColor=#23445d;labelBackgroundColor=default;" edge="1" parent="1" source="t_users" target="t_transactions"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="notes" value="Design rules&lt;br&gt;- transactions is the single source of truth (no separate expenses/incomes tables)&lt;br&gt;- wallet balance = opening_balance + income - expense + transfers in - transfers out (calculated)&lt;br&gt;- amounts are integers in minor units, always &gt; 0; currency is set per family&lt;br&gt;- INCOME/EXPENSE need category_id (type must match); TRANSFER needs to_wallet_id and no category&lt;br&gt;- every data table is scoped by family_id; role lives on members; RBAC checked on the server&lt;br&gt;- soft delete via deleted_at; edits use version (optimistic locking)&lt;br&gt;- default categories are copied into each family on creation (name_key, translated in the app)&lt;br&gt;- V2: add scope (family/personal) + owner_user_id to wallets and categories" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="800" width="680" height="190" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>